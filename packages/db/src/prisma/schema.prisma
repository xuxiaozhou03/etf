// 量化回测系统 Prisma Schema（骨架）
// 模型定义见 docs/02 §2，SyncTaskRun 见 docs/09 §3.3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 前复权日K线数据
model Kline {
  id            Int    @id @default(autoincrement())
  code          String
  date          Int // YYYYMMDD
  week          String?
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  amount        Float
  change        Float
  changePercent Float

  @@unique([code, date])
  @@index([code, date])
  @@map("kline")
}

/// 阶段收益（预计算存储）
model PeriodReturn {
  id           Int    @id @default(autoincrement())
  code         String
  periodType   String // 'weekly' | 'monthly' | 'quarterly' | 'yearly' | 'ytd'
  periodKey    String // '2024-W03' | '2024-01' | '2024-Q1' | '2024' | '2024-ytd'
  startDate    Int
  endDate      Int
  startPrice   Float
  endPrice     Float
  returnRate   Float
  returnAmount Float
  tradeDays    Int

  @@unique([code, periodType, periodKey])
  @@index([periodType, periodKey])
  @@map("periodReturn")
}

/// ETF/指数基础信息
model Security {
  code          String  @id
  name          String
  market        String // 'SH' | 'SZ'
  type          String // 'etf' | 'index' | 'stock'
  category      String? // '宽基' | '行业' | '主题' | '债券' | '商品' | '其他'
  trackingIndex String?
  scale         Float?

  @@map("security")
}

/// 同步任务执行历史（docs/09 §3.3）：判断"是否需要跳过"的依据
model SyncTaskRun {
  id         Int       @id @default(autoincrement())
  taskType   String // 'etf_list' | 'kline'
  taskKey    String? // kline 任务 = code
  params     String? // JSON 序列化；同类型不同参数视为不同任务
  status     String // 'success' | 'failed' | 'running'
  startedAt  DateTime
  finishedAt DateTime?
  error      String?

  @@unique([taskType, taskKey, params])
  @@index([taskType, taskKey])
  @@map("syncTaskRun")
}
