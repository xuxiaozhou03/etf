// 量化回测系统 Prisma Schema（骨架）
// 模型：日K（Kline）/ 阶段收益（PeriodReturn）/ 标的基础信息（Security）/ 同步任务历史（SyncTaskRun）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 前复权日K线数据
model Kline {
  code          String
  date          Int // YYYYMMDD
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  amount        Float
  change        Float
  changePercent Float

  @@unique([code, date])
  @@index([code, date])
  @@map("kline")
}

/// ETF基础信息
model Etf {
  code          String @id
  name          String
  trackingIndex String
  trackIndex    String
  scale         Float?

  @@map("etf")
}

model Feature {
  code String
  date Int // YYYYMMDD

  // 均线
  ma5        Float?
  ma20       Float?
  ma60       Float?
  ma5_ma20   Float?
  ma20_ma60  Float?
  close_ma20 Float?

  // 动量 / 区间收益率
  ret1w    Float? // 近一周
  ret1m    Float? // 近一月
  ret6m    Float? // 近6月
  ret1y    Float? // 近1年
  retYtd   Float? // 今年来
  ret3y    Float? // 近3年
  ret6y    Float? // 近6年
  retSince Float? // 成立以来
  rsi14    Float?

  // 波动率
  vol20      Float?
  atr14_norm Float?
  bb_width20 Float?

  // 量价
  vol_ratio5   Float?
  vol_ma5_ma20 Float?
  obv          Float?

  // 标签
  label_ret1 Float?
  label_ret5 Float?

  @@unique([code, date])
  @@index([code, date])
  @@index([date])
  @@map("feature")
}

/// 同步任务执行历史：判断「收盘后已完成 → 跳过」规则的依据
model SyncTaskRun {
  name       String // 'etf_list' | '[code]_kline'
  status     String // 'success' | 'failed'
  finishedAt DateTime?
  error      String?

  @@unique([name])
  @@map("syncTaskRun")
}
